{
  "multipart": [
    {
      "apply": {
        "model": "botania:block/large_mana_pool_floor"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "botania:block/large_mana_pool_rim",
        "y": 270
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "false"
          },
          {
            "east": "false"
          },
          {
            "north_east": "false"
          }
        ]
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post"
      }
    },
    {
      "when": {
        "OR": [
          {
            "east": "false"
          },
          {
            "south": "false"
          },
          {
            "south_east": "false"
          }
        ]
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post",
        "y": 90
      }
    },
    {
      "when": {
        "OR": [
          {
            "south": "false"
          },
          {
            "west": "false"
          },
          {
            "south_west": "false"
          }
        ]
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post",
        "y": 180
      }
    },
    {
      "when": {
        "OR": [
          {
            "west": "false"
          },
          {
            "north": "false"
          },
          {
            "north_west": "false"
          }
        ]
      },
      "apply": {
        "model": "botania:block/large_mana_pool_post",
        "y": 270
      }
    }
  ]
}
